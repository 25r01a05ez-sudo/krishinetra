# Base URL of the Flask backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Optional: request timeout in milliseconds (default 30000)
# VITE_API_TIMEOUT_MS=30000

# Optional: maximum upload size in MB (default 10)
# VITE_MAX_UPLOAD_MB=10

# Optional: URL of a real hero photograph (e.g. /images/hero.jpg placed in /public/images)
# VITE_HERO_IMAGE_URL=
